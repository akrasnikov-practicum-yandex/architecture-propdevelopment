    <diagram id="c4_context" name="C4 Context — Smart Home">
        <mxGraphModel dx="1744" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
