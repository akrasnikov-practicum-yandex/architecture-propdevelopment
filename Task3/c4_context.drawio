                <mxCell id="boundary_propdev" value="PropDevelopment" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];shape=mxgraph.c4.system_boundary;whiteSpace=wrap;html=1;strokeColor=#444444;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;dashed=1;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="380" y="280" width="520" height="440" as="geometry"/>
