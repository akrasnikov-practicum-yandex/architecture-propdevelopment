                <mxCell id="person_tenant" value="&lt;b&gt;Собственник&lt;/b&gt;&#10;[Person]&#10;&#10;Владелец квартиры в ЖК PropDevelopment. Использует мобильное приложение для оплаты ЖКУ, управления умным домофоном и шлагбаумом." style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="400" width="200" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="person_visitor" value="&lt;b&gt;Посетитель / Гость&lt;/b&gt;&#10;[Person]&#10;&#10;Лицо, которое звонит в домофон или въезжает на территорию ЖК. Идентифицируется по лицу или номеру автомобиля." style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6F;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="130" y="690" width="200" height="160" as="geometry"/>
